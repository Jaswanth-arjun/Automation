{
  "manifest_version": 3,
  "name": "Hamzo Apply",
  "version": "1.1.0",
  "description": "Stores your Hamzo profile and fills external job applications with your tailored resume.",
  "permissions": ["storage", "scripting", "tabs"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://localhost:5173/*", "http://127.0.0.1:5173/*", "http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["filler.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
