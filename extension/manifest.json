{
  "manifest_version": 3,
  "name": "Hamzooh Apply",
  "version": "1.5.3",
  "description": "Stores your Hamzooh profile and fills external job applications with your tailored resume.",
  "permissions": ["storage", "scripting", "tabs"],
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5174/*",
    "http://127.0.0.1:5174/*",
    "http://localhost:3000/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5174/*",
        "http://127.0.0.1:5174/*",
        "http://localhost:3000/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5174/*",
        "http://127.0.0.1:5174/*",
        "http://localhost:3000/*"
      ],
      "js": ["auto-trigger.js", "filler-enhancements.js", "filler.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
